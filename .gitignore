# ── Virtual environment ──────────────────────────────────────────────────────
.venv/

# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Large job output files — exclude heavy COLMAP data & media ───────────────
# Frames / Keyframes / Semantic images (MB per video)
jobs/**/frames/
jobs/**/keyframes/
jobs/**/semantics/
jobs/**/dynamic_masks/
# Dense stereo images
jobs/**/dense/images/
jobs/**/dense/stereo/
# Shell scripts generated by COLMAP
jobs/**/*.sh
# Binary COLMAP data files
jobs/**/*.bin
jobs/**/*.db
jobs/**/*.db-shm
jobs/**/*.db-wal
# Large COLMAP text model files (images.txt = 22MB, points3D.txt = 5MB)
jobs/**/images.txt
jobs/**/points3D.txt
jobs/**/frames.txt
# PLY / VIS point cloud files (multi-MB)
jobs/**/*.ply
jobs/**/*.ply.vis
# Video input files
jobs/**/*.mp4
jobs/**/*.avi
jobs/**/*.mov
jobs/**/*.mkv
# Keep: scene.json, buildings.json, colmap_report.json, status.json, job_meta.json, cameras.txt, rigs.txt, project.ini

# ── Raw video input ──────────────────────────────────────────────────────────
data/input/*.mp4
data/input/*.avi
data/input/*.mov
data/input/*.mkv
data/output/

# ── Large tool binaries ───────────────────────────────────────────────────────
tools/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
